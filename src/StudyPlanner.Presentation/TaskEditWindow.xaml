<Window x:Class="StudyPlanner.Presentation.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задание" Height="360" Width="420" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock Text="Название:"/>
        <TextBox x:Name="TitleBox" Height="26" Margin="0,2,0,8"/>
        <TextBlock Text="Дисциплина:"/>
        <TextBox x:Name="CourseBox" Height="26" Margin="0,2,0,8"/>
        <TextBlock Text="Срок:"/>
        <DatePicker x:Name="DeadlinePicker" Margin="0,2,0,8"/>
        <TextBlock Text="Описание:"/>
        <TextBox x:Name="DescBox" Height="60" Margin="0,2,0,12"
                 TextWrapping="Wrap" AcceptsReturn="True"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Width="100" Height="30" Margin="0,0,8,0" Click="Save_Click"/>
            <Button Content="Отмена" Width="90" Height="30" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
