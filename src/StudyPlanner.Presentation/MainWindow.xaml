<Window x:Class="StudyPlanner.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StudyPlanner — менеджер учебных дедлайнов" Height="520" Width="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Добавить" Width="110" Height="32" Margin="0,0,8,0" Click="Add_Click"/>
            <Button Content="Выполнено" Width="110" Height="32" Margin="0,0,8,0" Click="Done_Click"/>
            <Button Content="Удалить" Width="110" Height="32" Click="Delete_Click"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="SearchBox" Width="200" Height="26" Margin="0,0,12,0"
                     TextChanged="SearchBox_TextChanged"/>
            <TextBlock Text="Дисциплина:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="CourseBox" Width="150" Height="26"/>
            <CheckBox x:Name="OnlyActiveBox" Content="Только активные" Margin="12,0,0,0"
                      VerticalAlignment="Center" IsChecked="True" Click="Filter_Changed"/>
        </StackPanel>
        <DataGrid x:Name="TasksGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Задание" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Дисциплина" Binding="{Binding CourseName}" Width="130"/>
                <DataGridTextColumn Header="Срок" Binding="{Binding Deadline, StringFormat=d}" Width="100"/>
                <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="90"/>
                <DataGridCheckBoxColumn Header="Готово" Binding="{Binding IsDone}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" x:Name="StatsBar" Margin="0,10,0,0"/>
    </Grid>
</Window>
